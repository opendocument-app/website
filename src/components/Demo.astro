---
import Icon from './Icon.astro';
import Panel from './viewer/Panel.astro';
import Chrome from './viewer/Chrome.astro';
import { repos } from '../data/links';
---

<section id="try" class="border-y border-outline-variant/60 bg-surface-container/40 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">See for yourself</h2>
      <p class="mt-4 text-lg leading-relaxed text-on-surface-variant">
        This page runs the same C++ engine as the apps, compiled to WebAssembly.
        Drop a document below and it is decoded and laid out{' '}
        <strong class="font-semibold text-on-surface">inside your browser</strong> — nothing is
        uploaded, and the page works with your network switched off. Then press the pen: type
        into a text document and format it, change the numbers in a spreadsheet, mark up a PDF —
        and the disc hands you the file back, written by the same engine.
      </p>
    </div>

    <div
      id="demo"
      class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-2xl border border-outline-variant bg-surface shadow-sm"
    >
      <!-- Idle / loading / error all live here; the frame replaces it once a
           document renders. -->
      <Panel>
        <a
          slot="actions"
          data-viewer-expand
          href="/tryit"
          class="inline-flex items-center gap-2 rounded-full px-3 py-2.5 text-sm font-medium text-primary transition-colors hover:bg-surface-container"
        >
          <Icon name="expand" class="h-4 w-4" />
          Full screen
        </a>
      </Panel>

      <!-- Shown once something rendered. -->
      <div data-viewer-result hidden>
        <Chrome>
          <a
            slot="trailing"
            data-viewer-expand
            href="/tryit"
            aria-label="Open the full-screen viewer"
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-on-surface-variant transition-colors hover:bg-surface hover:text-on-surface"
          >
            <Icon name="expand" class="h-4 w-4" />
          </a>
        </Chrome>
        <!-- The frame is created per document rather than reused; see the
             viewer script for why. -->
        <div data-viewer-frame-host class="h-[32rem] w-full bg-surface-container"></div>
      </div>
    </div>

    <p class="mx-auto mt-5 max-w-2xl text-center text-sm text-on-surface-variant">
      Powered by{' '}
      <a
        href={repos.wasm}
        target="_blank"
        rel="noopener"
        class="font-medium text-primary underline-offset-4 hover:underline">@opendocument/odr-core</a
      > — the renderer is fetched only when you open something. Want the whole window?{' '}
      <a href="/tryit" class="font-medium text-primary underline-offset-4 hover:underline"
        >Open it full screen</a
      >.
    </p>
  </div>
</section>

<script>
  import { mountViewer } from '../scripts/viewer';

  const root = document.getElementById('demo');
  if (root) {
    mountViewer({
      root,
      // The demo is one section of a long page, so a file dropped from further
      // down scrolls the viewer into view before it starts working.
      scrollTarget: document.getElementById('try'),
    });
  }
</script>
