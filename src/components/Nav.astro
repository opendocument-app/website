---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getApp, repos } from '../data/links';

/* Only the button for the platform of the visitor shows; see `getApp`. The
   class names are written out in full, because Tailwind finds them in the
   source. */
const show = {
  android: 'hidden in-data-[platform=android]:block',
  ios: 'hidden in-data-[platform=ios]:block',
  desktop: 'hidden in-data-[platform=desktop]:block',
  fallback: 'in-data-[platform]:hidden',
} as const;

const sections = [
  { href: '/#try', label: 'Try it' },
  { href: '/#features', label: 'Features' },
  { href: '/#formats', label: 'Formats' },
  { href: '/#privacy', label: 'Privacy' },
  { href: '/#developers', label: 'Developers' },
];
---

<header
  class="sticky top-0 z-40 border-b border-outline-variant/60 bg-surface/85 backdrop-blur-md supports-[backdrop-filter]:bg-surface/70"
>
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6"
    aria-label="Main"
  >
    <a href="/#top" class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight">
      <Logo class="h-8 w-8" title="OpenDocument Reader" />
      <span class="hidden sm:inline">OpenDocument&nbsp;Reader</span>
      <span class="sm:hidden">ODR</span>
    </a>

    <ul class="ml-auto hidden items-center gap-1 lg:flex">
      {
        sections.map((s) => (
          <li>
            <a
              href={s.href}
              class="whitespace-nowrap rounded-lg px-3 py-2 text-sm text-on-surface-variant transition-colors hover:bg-surface-container hover:text-on-surface"
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={repos.org}
      target="_blank"
      rel="noopener"
      class="ml-auto shrink-0 rounded-lg p-2 text-on-surface-variant transition-colors hover:bg-surface-container hover:text-on-surface lg:ml-1"
      aria-label="OpenDocument Reader on GitHub"
    >
      <Icon name="github" class="h-5 w-5" />
    </a>

    {
      getApp.map((b) => (
        <a
          href={b.href}
          target={b.external ? '_blank' : undefined}
          rel={b.external ? 'noopener' : undefined}
          class:list={[
            'shrink-0 whitespace-nowrap rounded-full bg-primary px-4 py-2 text-sm font-medium text-on-primary transition-opacity hover:opacity-90',
            show[b.platform],
          ]}
        >
          {b.label}
        </a>
      ))
    }
  </nav>
</header>
