---
/*
  The bar above a mounted document: what is open, the zoom, and the way out.
  The demo puts it inside its own frame, which is hidden until something
  renders; `/tryit` uses it as the page's only bar, where the mark on the left
  has to stay put and everything about the document has to come and go. So the
  document half carries `data-viewer-open` and the script toggles it, which the
  demo pays nothing for - there it is inside a box that was hidden anyway.
*/
import Icon from '../Icon.astro';

interface Props {
  class?: string;
}
const {
  class: className = 'border-b border-outline-variant bg-surface-container px-4 py-2.5',
} = Astro.props;
---

<div class:list={['flex items-center gap-3', className]}>
  <slot name="lead" />

  <div data-viewer-open hidden class="flex min-w-0 flex-1 items-center gap-3">
    <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-brand-sheet"></span>
    <p data-viewer-filename class="min-w-0 flex-1 truncate text-sm font-medium"></p>

    <!-- The renderer fits the document to the width it is rendered for, and
         answers for the zoom after that through a script the frame does not get
         to run. A phone cannot pinch an iframe either, so these drive the zoom
         from outside. -->
    <div data-viewer-zoom hidden class="flex shrink-0 items-center gap-0.5">
      <button
        data-viewer-zoom-out
        type="button"
        aria-label="Zoom out"
        class="flex h-7 w-7 items-center justify-center rounded-full border border-outline text-sm leading-none transition-colors hover:bg-surface disabled:opacity-40"
      >&minus;</button>
      <button
        data-viewer-zoom-level
        type="button"
        title="Fit to width"
        class="min-w-[3.25rem] rounded-full px-1 py-1 text-xs font-medium tabular-nums transition-colors hover:bg-surface"
      >100%</button>
      <button
        data-viewer-zoom-in
        type="button"
        aria-label="Zoom in"
        class="flex h-7 w-7 items-center justify-center rounded-full border border-outline text-sm leading-none transition-colors hover:bg-surface disabled:opacity-40"
      >+</button>
    </div>

    <slot name="trailing" />

    <!-- Sized with the zoom buttons it sits beside, and named for what it
         does rather than what it looks like. -->
    <button
      data-viewer-reset
      type="button"
      aria-label="Close this document and open another"
      title="Close this document and open another"
      class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-outline transition-colors hover:bg-surface"
    >
      <Icon name="close" class="h-4 w-4" />
    </button>
  </div>
</div>

<!-- Only ever shown for a sheet the cell budget cut; see the viewer script. -->
<p
  data-viewer-cut
  hidden
  class="shrink-0 border-b border-outline-variant bg-surface-variant/40 px-4 py-2 text-xs leading-relaxed text-on-surface-variant"
>
</p>
