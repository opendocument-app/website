---
/*
  The viewer's idle, busy and error face - everything shown while no document
  is mounted. Shared by the demo section and `/tryit`, which differ only in how
  much room the zone gets.
*/
import Icon from '../Icon.astro';

interface Props {
  /** The box the zone sits in; the demo pads it, the full-screen page fills. */
  class?: string;
  /** The dashed zone itself, which the full-screen page stretches. */
  zoneClass?: string;
}
const { class: className = 'p-6 sm:p-10', zoneClass = '' } = Astro.props;
---

<div data-viewer-panel class={className}>
  <div
    data-viewer-zone
    class:list={[
      'flex flex-col items-center justify-center rounded-xl border-2 border-dashed border-outline-variant px-6 py-12 text-center transition-colors',
      zoneClass,
    ]}
  >
    <div
      data-viewer-spinner
      hidden
      class="mb-5 h-10 w-10 animate-spin rounded-full border-[3px] border-outline-variant border-t-primary"
    >
    </div>

    <div data-viewer-idle-icon class="mb-5 rounded-full bg-primary-container p-4 text-on-primary-container">
      <Icon name="upload" class="h-7 w-7" />
    </div>

    <p data-viewer-status class="text-lg font-medium">Drop a document here</p>
    <p data-viewer-hint class="mt-2 text-sm text-on-surface-variant">
      ODT, ODS, ODP, DOCX, XLSX, PPTX, PDF and more — it stays on your device
    </p>

    <div data-viewer-actions class="mt-7 flex flex-wrap items-center justify-center gap-3">
      <button
        data-viewer-pick
        type="button"
        class="rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
      >
        Choose a file
      </button>
      <button
        data-viewer-sample
        type="button"
        class="rounded-full border border-outline px-5 py-2.5 text-sm font-medium transition-colors hover:bg-surface-container"
      >
        Try a sample document
      </button>
      <slot name="actions" />
    </div>

    <input data-viewer-file type="file" class="sr-only" />
  </div>
</div>
