---
/*
  The viewer's idle, busy and error face - everything shown while no document
  is mounted. Shared by the demo section and `/tryit`, which differ only in how
  much room the zone gets.
*/
import Icon from '../Icon.astro';

interface Props {
  /** The box the zone sits in; the demo pads it, the full-screen page fills. */
  class?: string;
  /** The dashed zone itself, which the full-screen page stretches. */
  zoneClass?: string;
}
const { class: className = 'p-6 sm:p-10', zoneClass = '' } = Astro.props;

/*
  One sample per format, because what the engine can do depends on the format
  it was handed: the same content saved by LibreOffice as each of these. `does`
  is what the engine's own capability table says, checked when the samples were
  made, and the chip's tooltip states it. A visitor who wants to know whether a
  .doc can be edited here gets the answer before the wasm has loaded. The
  iWork three are the docx, xlsx and pptx saved again by Pages, Numbers and
  Keynote, with the preview pictures those apps pack in stripped out.
*/
type Does = 'edit' | 'mark' | 'read';
const samples: { ext: string; tone: 'text' | 'sheet' | 'slide' | 'plain'; does: Does }[] = [
  // In the order of importance: the OpenDocument formats this reader is for,
  // the formats everyone sends, the old Office formats, and then the rest.
  { ext: 'odt', tone: 'text', does: 'edit' },
  { ext: 'ods', tone: 'sheet', does: 'edit' },
  { ext: 'odp', tone: 'slide', does: 'edit' },
  { ext: 'odg', tone: 'text', does: 'edit' },
  { ext: 'pdf', tone: 'plain', does: 'mark' },
  { ext: 'docx', tone: 'text', does: 'edit' },
  { ext: 'xlsx', tone: 'sheet', does: 'edit' },
  { ext: 'pptx', tone: 'slide', does: 'edit' },
  { ext: 'doc', tone: 'text', does: 'read' },
  { ext: 'xls', tone: 'sheet', does: 'read' },
  { ext: 'ppt', tone: 'slide', does: 'read' },
  { ext: 'csv', tone: 'sheet', does: 'read' },
  { ext: 'txt', tone: 'plain', does: 'edit' },
  { ext: 'rtf', tone: 'text', does: 'read' },
  { ext: 'pages', tone: 'text', does: 'read' },
  { ext: 'numbers', tone: 'sheet', does: 'read' },
  { ext: 'key', tone: 'slide', does: 'read' },
  { ext: 'md', tone: 'plain', does: 'read' },
];

const titles: Record<Does, string> = {
  edit: 'Opens, edits and saves',
  mark: 'Opens, takes marks and saves',
  read: 'Opens — this format is read here, not written',
};

/* The tile is drawn in the format's colour: the sheet's tint and its edge, and
   the extension printed on it. */
const tones = {
  text: 'text-brand-text',
  sheet: 'text-brand-sheet',
  slide: 'text-brand-slide',
  plain: 'text-on-surface-variant',
} as const;
---

<div data-viewer-panel class={className}>
  <div
    data-viewer-zone
    class:list={[
      'flex flex-col items-center justify-center-safe overflow-y-auto rounded-xl border-2 border-dashed border-outline-variant px-6 py-10 text-center transition-colors',
      zoneClass,
    ]}
  >
    <div
      data-viewer-spinner
      hidden
      class="mb-5 h-10 w-10 animate-spin rounded-full border-[3px] border-outline-variant border-t-primary"
    >
    </div>

    <div data-viewer-idle-icon class="mb-5 rounded-full bg-primary-container p-4 text-on-primary-container">
      <Icon name="upload" class="h-7 w-7" />
    </div>

    <p data-viewer-status class="text-lg font-medium">Drop a document here</p>
    <p data-viewer-hint class="mt-2 text-sm text-on-surface-variant">
      ODT, ODS, ODP, DOCX, XLSX, PPTX, PDF and more — it stays on your device
    </p>

    <div data-viewer-actions class="mt-7 flex flex-col items-center gap-5">
      <div class="flex flex-wrap items-center justify-center gap-3">
        <button
          data-viewer-pick
          type="button"
          class="rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-on-primary transition-opacity hover:opacity-90"
        >
          Choose a file
        </button>
        <slot name="actions" />
      </div>

      <!-- Or a sample: one per format, drawn as the file it is - a sheet with a
           folded corner, the extension on it, and a pen or a marker on the
           corner of the ones that can be changed here. -->
      <div class="flex max-w-2xl flex-col items-center gap-3">
        <p class="text-xs text-on-surface-variant">
          Or try a sample — a pen marks the ones you can change here
        </p>
        <ul class="flex flex-wrap items-start justify-center gap-x-1.5 gap-y-3">
          {
            samples.map((s) => (
              <li>
                <button
                  data-viewer-sample={`/samples/sample.${s.ext}`}
                  type="button"
                  title={titles[s.does]}
                  class:list={[
                    'group relative flex w-14 flex-col items-center rounded-lg px-1 pb-1 pt-1.5 transition-colors hover:bg-surface-container',
                    tones[s.tone],
                  ]}
                >
                  <span class="relative block h-12 w-10">
                    <svg viewBox="0 0 40 48" class="h-full w-full" aria-hidden="true">
                      <path
                        d="M5 2.5h20l10 10v33H5z"
                        fill="currentColor"
                        fill-opacity="0.09"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linejoin="round"
                        class="transition-[fill-opacity] group-hover:[fill-opacity:0.18]"
                      />
                      <path
                        d="M25 2.5v10h10"
                        fill="var(--md-surface)"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linejoin="round"
                      />
                      <path d="M11 24h18M11 30h18M11 36h12" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    {s.does !== 'read' && (
                      <span class="absolute -bottom-1 -right-1.5 flex h-4.5 w-4.5 items-center justify-center rounded-full bg-primary text-on-primary ring-2 ring-surface">
                        <Icon name={s.does === 'edit' ? 'pencil' : 'highlighter'} class="h-2.5 w-2.5" />
                      </span>
                    )}
                  </span>
                  <span class="mt-1 text-[11px] font-bold uppercase leading-none tracking-wide">{s.ext}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <input data-viewer-file type="file" class="sr-only" />
  </div>
</div>
