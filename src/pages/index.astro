---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Demo from '../components/Demo.astro';
import Features from '../components/Features.astro';
import Formats from '../components/Formats.astro';
import Openness from '../components/Openness.astro';
import Developers from '../components/Developers.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="OpenDocument Reader — view ODT, ODS and ODP on Android and iOS"
  description="Open OpenOffice and LibreOffice documents on your phone. ODT, ODS, ODP, DOCX, XLSX, PPTX and PDF, offline and without uploading anything. Free and open source."
>
  <Nav />
  <main id="main">
    <Hero />
    <Demo />
    <Features />
    <Formats />
    <Openness />
    <Developers />
    <Download />
  </main>
  <Footer />
</Base>
