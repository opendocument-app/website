{
  "id": "/web",
  "name": "OpenDocument Reader",
  "short_name": "ODR",
  "description": "Open, edit and save office documents and PDFs. The document stays on your device.",
  "start_url": "/web",
  "scope": "/web",
  "display": "standalone",
  "background_color": "#fcfcff",
  "theme_color": "#fcfcff",
  "categories": [
    "productivity",
    "business",
    "utilities"
  ],
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New text document",
      "short_name": "Text document",
      "url": "/web?new=odt",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New spreadsheet",
      "short_name": "Spreadsheet",
      "url": "/web?new=ods",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=at.tomtasche.reader",
      "id": "at.tomtasche.reader"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/id1510195065"
    }
  ],
  "prefer_related_applications": true,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/web",
      "accept": {
        "application/vnd.oasis.opendocument.text": [
          ".odt",
          ".ott",
          ".fodt",
          ".odm"
        ],
        "application/vnd.oasis.opendocument.spreadsheet": [
          ".ods",
          ".ots",
          ".fods"
        ],
        "application/vnd.oasis.opendocument.presentation": [
          ".odp",
          ".otp",
          ".fodp"
        ],
        "application/vnd.oasis.opendocument.graphics": [
          ".odg",
          ".otg",
          ".fodg"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx",
          ".docm",
          ".dotx",
          ".dotm"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx",
          ".xlsm",
          ".xltx",
          ".xltm"
        ],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx",
          ".pptm",
          ".potx",
          ".potm",
          ".ppsx",
          ".ppsm"
        ],
        "application/msword": [
          ".doc",
          ".dot"
        ],
        "application/vnd.ms-excel": [
          ".xls",
          ".xlt"
        ],
        "application/vnd.ms-powerpoint": [
          ".ppt",
          ".pot",
          ".pps"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/rtf": [
          ".rtf"
        ],
        "application/vnd.apple.pages": [
          ".pages"
        ],
        "application/vnd.apple.numbers": [
          ".numbers"
        ],
        "application/vnd.apple.keynote": [
          ".key"
        ],
        "text/plain": [
          ".txt"
        ],
        "text/csv": [
          ".csv"
        ],
        "text/markdown": [
          ".md",
          ".markdown"
        ]
      }
    }
  ]
}
